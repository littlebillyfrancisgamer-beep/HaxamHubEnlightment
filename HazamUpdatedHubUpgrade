local function ShowNotification(textMsg)
	pcall(function()
		local Notif = Instance.new("Frame")
		Notif.Name = "Notification"
		Notif.Parent = ScreenGui
		Notif.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
		Notif.BorderColor3 = Color3.fromRGB(0, 170, 255)
		Notif.BorderSizePixel = 0
		Notif.Position = UDim2.new(1, 10, 1, -70)
		Notif.Size = UDim2.new(0, 250, 0, 50)
		Notif.BackgroundTransparency = 0.1
		Notif.ZIndex = 5
		AddCorner(Notif, UDim.new(0, 8))

		local NotifText = Instance.new("TextLabel")
		NotifText.Parent = Notif
		NotifText.BackgroundTransparency = 1
		NotifText.Size = UDim2.new(1, 0, 1, 0)
		NotifText.Font = Enum.Font.Arcade
		NotifText.Text = textMsg
		NotifText.TextColor3 = Color3.fromRGB(255, 255, 255)
		NotifText.TextSize = 14
		NotifText.ZIndex = 5

		local slideIn = TweenService:Create(Notif, TweenInfo.new(0.4, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
			Position = UDim2.new(1, -260, 1, -70)
		})
		slideIn:Play()

		task.delay(3, function()
			pcall(function()
				local slideOut = TweenService:Create(Notif, TweenInfo.new(0.4, Enum.EasingStyle.Exponential, Enum.EasingDirection.In), {
					Position = UDim2.new(1, 10, 1, -70)
				})
				slideOut:Play()
				slideOut.Completed:Connect(function() Notif:Destroy() end)
			end)
		end)
	end)
end

