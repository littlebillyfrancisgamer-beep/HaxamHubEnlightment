				if p ~= Player then
					pcall(function()
						scanStatusLabel.Text = "Scanning: " .. p.Name
						scanStatusLabel.TextColor3 = Color3.fromRGB(80, 255, 120)
						
						if p.Character then
							local tempHl = p.Character:FindFirstChild("ScanHighlightTemp")
							if not tempHl then
								tempHl = Instance.new("Highlight")
								tempHl.Name = "ScanHighlightTemp"
								tempHl.FillColor = Color3.fromRGB(255, 200, 0)
								tempHl.OutlineColor = Color3.fromRGB(255, 255, 255)
								tempHl.FillTransparency = 0.3
								tempHl.Parent = p.Character
							end
							task.delay(0.6, function()
								if tempHl then tempHl:Destroy() end
							end)
						end
					end)
					task.wait(0.6)
				end
			end
			if scanPlayersEnabled then
				scanStatusLabel.Text = "Refreshing loop..."
				scanStatusLabel.TextColor3 = Color3.fromRGB(0, 170, 255)
				task.wait(0.5)
			end
		else
			task.wait(0.5)
