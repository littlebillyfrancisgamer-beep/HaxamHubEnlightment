RunService.RenderStepped:Connect(function(dt)
	pcall(function()
		if dt > 0 then
			local fps = math.floor(1 / dt)
			local ms = math.floor((dt * 1000) * 100 + 0.5) / 100
			FpsCounterDisplay.Text = string.format("FPS: %d | Frame Time: %.2f ms", fps, ms)
			
			if fps >= 60 then
				FpsCounterDisplay.TextColor3 = Color3.fromRGB(80, 255, 120)
			elseif fps >= 30 then
				FpsCounterDisplay.TextColor3 = Color3.fromRGB(255, 220, 50)
			else
				FpsCounterDisplay.TextColor3 = Color3.fromRGB(255, 80, 80)
			end
		end
	end)
end)

-- Console Output Logging
LogService.MessageOut:Connect(function(message, messageType)
	pcall(function()
		local logRow = Instance.new("Frame")
		logRow.Parent = ConsoleScroll
		logRow.BackgroundTransparency = 1
		logRow.Size = UDim2.new(1, 0, 0, 22)
		logRow.AutomaticSize = Enum.AutomaticSize.Y
		logRow.ZIndex = 2

		local logLabel = Instance.new("TextLabel")
		logLabel.Parent = logRow
		logLabel.BackgroundTransparency = 1
		logLabel.Position = UDim2.new(0, 0, 0, 0)
		logLabel.Size = UDim2.new(1, -55, 1, 0)
		logLabel.Font = Enum.Font.Arcade
		logLabel.TextSize = 12
		logLabel.TextXAlignment = Enum.TextXAlignment.Left
		logLabel.TextWrapped = true
		logLabel.AutomaticSize = Enum.AutomaticSize.Y
		logLabel.Text = message
		logLabel.ZIndex = 2

		if messageType == Enum.MessageType.MessageOutput then
			logLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
		elseif messageType == Enum.MessageType.MessageWarning then
			logLabel.TextColor3 = Color3.fromRGB(255, 220, 50)
		elseif messageType == Enum.MessageType.MessageError then
			logLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
		elseif messageType == Enum.MessageType.MessageInfo then
			logLabel.TextColor3 = Color3.fromRGB(80, 180, 255)
		else
			logLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		end

		local copyLogBtn = Instance.new("TextButton")
		copyLogBtn.Parent = logRow
		copyLogBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
		copyLogBtn.BorderSizePixel = 0
		copyLogBtn.Position = UDim2.new(1, -50, 0, 2)
		copyLogBtn.Size = UDim2.new(0, 48, 0, 18)
		copyLogBtn.Font = Enum.Font.Arcade
		copyLogBtn.Text = "Copy"
		copyLogBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		copyLogBtn.TextSize = 11
		copyLogBtn.ZIndex = 2
		AddCorner(copyLogBtn, UDim.new(0, 4))

		copyLogBtn.MouseButton1Click:Connect(function()
			pcall(function()
				if setclipboard then
					setclipboard(message)
					ShowNotification("Copied log message to clipboard!")
				end
			end)
		end)

		ConsoleScroll.CanvasPosition = Vector2.new(0, ConsoleScroll.AbsoluteCanvasSize.Y)
	end)
end)

ClearConsoleBtn.MouseButton1Click:Connect(function()
